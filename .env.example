# SMTP configuration (replace the example values with the real credentials)
# Do not wrap the values in quotes when defining them in your environment.
SMTP_HOST=mail.karailesno.bg
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@karailesno.bg
SMTP_PASS=replace-with-the-real-password

# Optional helper for local testing without an SMTP server
# SMTP_TRANSPORT=json

# Optional override for the recipient inbox (defaults to office@karailesno.bg)
# Multiple addresses are supported using commas, semicolons, or newlines
# CONTACT_TO_EMAIL=office@karailesno.bg,second@example.com

# Optional override for the client-side endpoint URL
# VITE_CONTACT_ENDPOINT="/.netlify/functions/send-email"
