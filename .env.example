# Front-end configuration
VITE_CONTACT_ENDPOINT=http://localhost:3000/api/contact

# Mail server configuration used by server/index.mjs
SMTP_TRANSPORT=smtp
SMTP_HOST=mail.karailesno.bg
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=websitenotification@karailesno.bg
SMTP_PASS=enter-password-here
CONTACT_RECIPIENT=office@karailesno.bg
# Optional: override the "From" header (defaults to SMTP_USER)
CONTACT_SENDER=websitenotification@karailesno.bg
# Optional: disable verbose SMTP logs by setting to "false"
SMTP_DEBUG=true
# Comma-separated list of origins allowed to call the API
CONTACT_ALLOWED_ORIGINS=http://localhost:5173
